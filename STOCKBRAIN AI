import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split

# =========================
# DOWNLOAD STOCK DATA
# =========================

ticker = "AAPL"

data = yf.download(
    ticker,
    start="2020-01-01",
    end="2024-01-01"
)

print(data.head())

# =========================
# FEATURE ENGINEERING
# =========================

data["Target"] = data["Close"].shift(-1)

data["MA10"] = data["Close"].rolling(10).mean()
data["MA50"] = data["Close"].rolling(50).mean()

data = data.dropna()

# Features
X = data[["MA10", "MA50"]]

# Target
y = data["Target"]

# =========================
# TRAIN MODEL
# =========================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.2,
    shuffle=False
)

model = LinearRegression()

model.fit(X_train, y_train)

# =========================
# AGENT DECISION MAKING
# =========================

predictions = model.predict(X_test)

agent_actions = []

for current, predicted in zip(
    y_test.values,
    predictions
):

    if predicted > current:
        action = "BUY"

    else:
        action = "SELL"

    agent_actions.append(action)

# =========================
# RESULTS
# =========================

results = pd.DataFrame({
    "Actual": y_test.values,
    "Predicted": predictions,
    "Action": agent_actions
})

print("\n========================")
print(" AGENT DECISIONS ")
print("========================\n")

print(results.head(20))

# =========================
# VISUALIZATION
# =========================

plt.figure(figsize=(14, 6))

plt.plot(
    y_test.values,
    label="Actual Price",
    linewidth=2
)

plt.plot(
    predictions,
    label="Predicted Price",
    linewidth=2
)

plt.title(
    f"{ticker} Autonomous Trading Agent"
)

plt.xlabel("Time")
plt.ylabel("Stock Price")

plt.legend()

plt.grid()

plt.show()

# =========================
# AGENT PERFORMANCE
# =========================

correct = 0

for actual, predicted in zip(
    y_test.values[:-1],
    predictions[:-1]
):

    actual_direction = (
        y_test.values[1] > actual
    )

    predicted_direction = (
        predicted > actual
    )

    if actual_direction == predicted_direction:
        correct += 1

accuracy = (
    correct / len(predictions[:-1])
) * 100

print("\n========================")
print(" AGENT PERFORMANCE ")
print("========================\n")

print(f"Decision Accuracy: {accuracy:.2f}%")
